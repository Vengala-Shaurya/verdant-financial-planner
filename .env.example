# VERDANT Environment Configuration
PORT=5001
FLASK_ENV=development

# --- AI Configuration (Groq or Google Gemini) ---
# Option 1: Groq API (High-speed free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option 2: Google Gemini API (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
