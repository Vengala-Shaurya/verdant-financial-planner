# VERDANT Environment Configuration
PORT=5001
FLASK_ENV=development

# Google Gemini API Configuration (Official GenAI SDK)
# Obtain a free-tier API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier: gemini-2.5-flash is Google's recommended lightweight, fastest model with a 100% free tier (15 RPM / 1,500 RPD)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
